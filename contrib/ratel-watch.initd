#!/sbin/openrc-run
# OpenRC service for `ratel watch` (Alpine). Install:
#   install -m755 ratel /usr/local/bin/ratel
#   install -m755 contrib/ratel-watch.initd /etc/init.d/ratel-watch
#   install -Dm644 contrib/watch.conf /etc/ratel/watch.conf
#   rc-update add ratel-watch default && rc-service ratel-watch start

name="ratel-watch"
description="ratel network behaviour monitor (exfiltration, C2, tunnels, scans)"
command="/usr/local/bin/ratel"
command_args="watch --config /etc/ratel/watch.conf"
# supervise-daemon restarts it if it dies (ratel also raises a "not stopped cleanly"
# alert on the next start, so a crash or a kill is never silent)
supervisor=supervise-daemon
respawn_delay=5
respawn_max=10
respawn_period=3600
output_log="/var/log/ratel/watch.log"
error_log="/var/log/ratel/watch.log"
# lower CPU priority; the packet filter runs in the kernel either way
supervise_daemon_args="--nicelevel 10"
retry="TERM/15/KILL/5"

depend() {
	need net
	after firewall prosody docker
}

start_pre() {
	# group "ratel" = the ratel-web dashboard user: read-only access, plus the feedback inbox
	if getent group ratel >/dev/null; then
		# setgid: files the daemon creates inherit group ratel (umask 027 -> 0640)
		checkpath -d -m 2750 -o root:ratel /var/lib/ratel /var/log/ratel /run/ratel /var/lib/ratel/incidents
		checkpath -d -m 2770 -o root:ratel /var/lib/ratel/feedback.d
	else
		checkpath -d -m 0750 -o root:root /var/lib/ratel /var/log/ratel /run/ratel
	fi
}
